# v2 local development defaults
APP_ENV=development
ADDR=127.0.0.1:8080
DATABASE_URL=postgres://polyphone:polyphone@127.0.0.1:55432/polyphone?sslmode=disable
DB_MAX_CONNS=12
DB_MIN_CONNS=1
# 首次注册此邮箱的账号会成为管理员。上线前务必改成你自己的邮箱。
ADMIN_EMAIL=
SESSION_TTL=720h
SESSION_COOKIE=pc_session
COOKIE_SECURE=false
TRUST_PROXY=false
GLOSSARY_SYNC=false
